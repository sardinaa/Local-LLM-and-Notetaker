# =============================================================================
# LLM Notetaker Environment Configuration
# =============================================================================

# =========================
# Compose & Template Settings
# =========================

# Model Size Configuration - Choose your preference:
# - SMALL: Fast responses, lower quality (deepseek-coder for most tasks)
# - MEDIUM: Balanced speed/quality (mistral/llama3 for most tasks) 
# - HIGH: Best quality, slower responses (gpt-oss for all tasks)
MODEL_SIZE=HIGH                 # Options: SMALL, MEDIUM, HIGH
BRAVE_API_KEY=BSAxfihSqqUJXgGPvZJduSZhcZbfnQB
SEARXNG_URL=http://localhost:8080
YACY_URL=http://localhost:8090

# Token limits for different actions (higher = more detailed output)
RECIPE_MAX_TOKENS=2500          # Tokens for recipe templates (detailed recipes)
TEMPLATE_MAX_TOKENS=1500        # Tokens for general templates
GENERATE_MAX_TOKENS=1200        # Tokens for content generation
COMPOSE_MAX_TOKENS=800          # Tokens for other compose actions (simplify, improve, etc.)

# Model selection (based on MODEL_SIZE setting above)
# HIGH quality models (current setting):
COMPOSE_MODEL=gpt-oss:latest    # Main model for compose actions (high quality, 13GB)
RECIPE_MODEL=gpt-oss:latest     # Specific model for recipe generation (high quality, 13GB)
AGENT_MODEL=llama3:latest # Model for agent interactions (faster, 776MB)
RAG_MODEL=gpt-oss:latest        # Model for RAG generation and analysis (high quality)

# Input text limits
COMPOSE_MAX_CHARS=8000          # Maximum characters for input text
COMPOSE_CONCURRENCY=2           # Maximum parallel compose operations

# =========================
# Database Settings
# =========================

# Database path (optional override)
# DATABASE_PATH=data/db/notetaker.db

# =========================
# Audio & TTS Settings
# =========================

# Whisper model for audio transcription
WHISPER_MODEL=medium            # Options: tiny, base, small, medium, large, large-v2, large-v3

# =========================
# Development Settings
# =========================

# Flask debug mode
# FLASK_DEBUG=true
# FLASK_ENV=development

# =========================
# RAG Settings
# =========================

# RAG models configuration (based on MODEL_SIZE setting)
RAG_EMBEDDING_MODEL=nomic-embed-text:latest  # Model for document embeddings (always same)

JOB_SCRAPER_PROVIDER=jobspy

# =========================
# Chat Agent Settings
# =========================

# Storage paths
CHAT_AGENT_STORAGE_PATH=data/config/agents
CHAT_AGENT_VECTOR_STORE_DIR=data/chroma_db

# Agent defaults (chunk sizes, retrieval settings)
CHAT_AGENT_CHUNK_SIZE=800
CHAT_AGENT_CHUNK_OVERLAP=200
CHAT_AGENT_TOP_K=5  # Max number of chunks to retrieve
CHAT_AGENT_MIN_TOP_K=2  # Minimum number of chunks (even if low relevance)
CHAT_AGENT_RELEVANCE_THRESHOLD=0.5  # Minimum similarity score (0.0-1.0) to include chunk
CHAT_AGENT_TEMPERATURE=0.7
CHAT_AGENT_MAX_TOKENS=2000

# Memory configuration
CHAT_AGENT_MEMORY_ENABLED=true
CHAT_AGENT_MAX_HISTORY=5

# Retrieval configuration
CHAT_AGENT_SEARCH_STRATEGY=hybrid  # Options: keyword, semantic, hybrid
CHAT_AGENT_ENABLE_RERANKING=true

# File upload limits
CHAT_AGENT_MAX_FILE_SIZE_MB=10
CHAT_AGENT_ALLOWED_EXTENSIONS=pdf,docx,txt,csv,md

# Performance
CHAT_AGENT_REQUEST_TIMEOUT=120

# =========================
# Ollama Connection
# =========================

# Ollama API URL (if not running on localhost)
# OLLAMA_URL=http://127.0.0.1:11434

# =========================
# Performance Tuning
# =========================

# Quick MODEL_SIZE switching guide:
# 
# To use SMALL models (fastest, 776MB):
# 1. Change MODEL_SIZE=SMALL above
# 2. Uncomment the SMALL models section above
# 3. Comment out the current HIGH models
# 4. Optionally reduce token limits for even faster responses
#
# To use MEDIUM models (balanced, ~4GB):
# 1. Change MODEL_SIZE=MEDIUM above  
# 2. Uncomment the MEDIUM models section above
# 3. Comment out the current HIGH models
#
# To use HIGH models (best quality, 13GB):
# 1. Keep MODEL_SIZE=HIGH (current setting)
# 2. Keep current model configuration

# For very detailed recipes with HIGH models:
# RECIPE_MAX_TOKENS=3500

# For fastest responses with SMALL models:
# RECIPE_MAX_TOKENS=1500
# COMPOSE_MAX_TOKENS=600
# COMPOSE_CONCURRENCY=4

# =========================
# Usage Instructions
# =========================

# MODEL_SIZE Configuration Summary:
#
# SMALL (776MB total):
# - All models use deepseek-coder:latest
# - Fastest responses (~1-2 seconds)
# - Good for basic tasks, coding assistance
# - Low memory usage
#
# MEDIUM (~4-5GB total):  
# - Main models use mistral:latest or llama3:latest
# - Agents still use deepseek-coder:latest
# - Balanced speed/quality (~3-5 seconds)
# - Good general purpose setting
#
# HIGH (13GB+ total):
# - Main models use gpt-oss:latest  
# - Best quality responses (~5-10 seconds)
# - Ideal for complex tasks, detailed recipes
# - Requires more memory

# Available models on this system:
# - gpt-oss:latest (13GB) - Highest quality, slower
# - mistral:latest (4.4GB) - Good balance of speed/quality  
# - llama3:latest (4.7GB) - Good general purpose model
# - deepseek-coder:latest (776MB) - Fast, good for code/agents
# - deepseek-r1:7b (4.7GB) - Alternative medium-size model
# - nomic-embed-text:latest (274MB) - Embedding model

# To switch model sizes:
# 1. Change MODEL_SIZE variable above (SMALL/MEDIUM/HIGH)
# 2. Update the model assignments in the model selection section
# 3. Optionally adjust token limits for your preference
# 4. Restart the application
ENABLE_QWANT=false
