      },
      {
        "type": "paragraph",
        "data": {
          "text": "Pro tip: Combine different organizational methods for maximum effectiveness. For example, use folders for project structure and tags for topics that span multiple projects. See <a href=\"#note:note-best-practices\" class=\"note-link\" data-note-id=\"note-best-practices\">Note Best Practices</a> for more guidance."
        }
      }
