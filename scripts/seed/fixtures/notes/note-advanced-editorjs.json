      {
        "type": "list",
        "data": {
          "style": "ordered",
          "items": [
            "Step one: Install dependencies from <a href=\"https://www.npmjs.com/package/@editorjs/editorjs\" target=\"_blank\" rel=\"noopener\">npm registry</a>",
