# Search Engine Configuration
# Copy relevant settings to your main .env file or source this file

# ============================================================================
# DOMAIN WHITELIST - Filter search results to trusted domains only
# ============================================================================
# Comma-separated list of domains. Only results from these domains will be returned.
# This helps filter out low-quality or irrelevant results.
# 
# Examples for different use cases:

# General high-quality sources (uncomment to use):
# SEARCH_DOMAIN_FILTER_LIST=wikipedia.org,stackoverflow.com,github.com,reddit.com,medium.com

# Travel-related sources (for train/travel queries):
# SEARCH_DOMAIN_FILTER_LIST=renfe.com,sncf.com,trenitalia.com,bahn.de,eurail.com,seat61.com,rome2rio.com

# Technical/programming sources:
# SEARCH_DOMAIN_FILTER_LIST=stackoverflow.com,github.com,docs.python.org,mozilla.org,w3schools.com

# News and current events:
# SEARCH_DOMAIN_FILTER_LIST=bbc.com,reuters.com,apnews.com,theguardian.com,nytimes.com

# Academic sources:
# SEARCH_DOMAIN_FILTER_LIST=wikipedia.org,scholar.google.com,arxiv.org,nature.com,science.org

# Mixed: high-quality general sources + travel
SEARCH_DOMAIN_FILTER_LIST=wikipedia.org,renfe.com,sncf.com,seat61.com,rome2rio.com,bahn.de,trenitalia.com,eurail.com,stackoverflow.com,github.com

# ============================================================================
# SEARCH ENGINES - Enable better quality engines
# ============================================================================

# Qwant (FREE unlimited, no API key needed - European search engine)
ENABLE_QWANT=true

# Brave Search API (FREE 2,000 queries/month - sign up at https://brave.com/search/api/)
# BRAVE_API_KEY=your_key_here

# Mojeek API (FREE 1,000 queries/month - sign up at https://www.mojeek.com/services/api/signup/)
# MOJEEK_API_KEY=your_key_here

# SearXNG (Self-hosted metasearch - unlimited free)
# Run: docker run -d -p 8080:8080 searxng/searxng
# SEARXNG_URL=http://localhost:8080

# YaCy (Self-hosted P2P search - unlimited free)
# Run: docker run -d -p 8090:8090 yacy/yacy_search_server
# YACY_URL=http://localhost:8090

# ============================================================================
# SEARCH BEHAVIOR
# ============================================================================

# Enable automatic fallback to other engines if primary fails
ENABLE_SEARCH_FALLBACK=true

# DuckDuckGo region (wt-wt=worldwide, es-es=Spain, en-us=USA, etc.)
SEARCH_REGION=wt-wt

# Result counts
SEARCH_MIN_RESULTS=2
SEARCH_MAX_RESULTS=6
SEARCH_RESULT_COUNT=3

# Quality thresholds
SEARCH_MIN_QUALITY=0.3
SEARCH_MIN_WORDS=100

# Performance
SEARCH_CONCURRENT_REQUESTS=10
SEARCH_FETCH_TIMEOUT=30.0
SEARCH_MAX_TEXT_CHARS=8000
